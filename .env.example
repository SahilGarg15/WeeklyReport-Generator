# ─────────────────────────────────────────────────────────────────
#  AI Automated Weekly Reporting System — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────
# Groq API key (free) — https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ── EMAIL ATTACHMENT DELIVERY (optional) ─────────────────────────
# Gmail address that sends the report
EMAIL_SENDER=your_gmail@gmail.com

# Gmail App Password — NOT your login password
# Steps:
#   1. Google Account → Security → 2-Step Verification → enable
#   2. https://myaccount.google.com/apppasswords → create password
#   3. Paste the 16-char code below (spaces are fine, they get stripped)
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ─────────────────────────────────────────────────────────────────
# All other settings (model, thresholds, company name) live in config.json
# ─────────────────────────────────────────────────────────────────
