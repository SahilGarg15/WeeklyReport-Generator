# ─────────────────────────────────────────────────────────────────
#  .gitignore — AI Weekly Report Generator
# ─────────────────────────────────────────────────────────────────

# !! NEVER commit these !!
.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Generated reports (runtime output)
reports/*
!reports/.gitkeep

# Logs (runtime output)
logs/*
!logs/.gitkeep
*.log

# IDE / editor
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/
